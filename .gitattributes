# Fix line endings cho Husky hooks (bắt buộc trên Windows)
# Git hooks yêu cầu LF, không phải CRLF
.husky/* text eol=lf

# Java source files
*.java text eol=lf

# Properties và YAML
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.sh text eol=lf
*.js text eol=lf

# Windows batch files giữ CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
